<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.13</version>
		<relativePath/>
	</parent>

	<groupId>com.mugsun</groupId>
	<artifactId>mugsun-core</artifactId>
	<version>0.1.0</version>
	<packaging>pom</packaging>
	<name>mugsun-core</name>
	<description>Mugsun platform shared kernel: BOM, core tools, and Spring Boot starters</description>
	<url>https://github.com/mugsun/mugsun-core</url>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/license/mit</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>王定旭</name>
			<organization>mugsun</organization>
			<organizationUrl>https://mugsun.com</organizationUrl>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:git://github.com/mugsun/mugsun-core.git</connection>
		<developerConnection>scm:git:ssh://github.com/mugsun/mugsun-core.git</developerConnection>
		<url>https://github.com/mugsun/mugsun-core</url>
		<tag>HEAD</tag>
	</scm>

	<properties>
		<java.version>21</java.version>
		<mugsun.version>0.1.0</mugsun.version>
		<mybatis-flex.version>1.11.8</mybatis-flex.version>
		<mybatis-spring.version>3.0.5</mybatis-spring.version>
		<mybatis.version>3.5.19</mybatis.version>
		<sa-token.version>1.44.0</sa-token.version>
		<jetcache.version>2.7.9</jetcache.version>
		<x-file-storage.version>2.3.0</x-file-storage.version>
		<minio.version>8.5.17</minio.version>
		<!-- 对齐 x-file-storage-core 2.3.0 编译期 provided 版本 -->
		<aliyun-oss.version>3.16.1</aliyun-oss.version>
		<sms4j.version>3.3.4</sms4j.version>
		<warm-flow.version>1.8.8</warm-flow.version>
		<powerjob.version>5.1.2</powerjob.version>
		<liteflow.version>2.16.0</liteflow.version>
		<fastexcel.version>1.3.0</fastexcel.version>
		<hutool.version>5.8.39</hutool.version>
		<bouncycastle.version>1.82</bouncycastle.version>
		<springdoc.version>2.8.17</springdoc.version>
		<justauth.version>1.16.7</justauth.version>
		<!-- 离线 IP 归属地：ip2region（xdb 查询客户端，数据文件外置不入库） -->
		<ip2region.version>3.3.7</ip2region.version>
		<!-- fastjson2 的 v1 兼容桥接：替换 JustAuth 传递的旧 fastjson 1.x，消除供应链风险 -->
		<fastjson2.version>2.0.61</fastjson2.version>
		<!-- Maven Central publishing (release profile only) -->
		<central-publishing.version>0.11.0</central-publishing.version>
		<maven-source-plugin.version>3.3.1</maven-source-plugin.version>
		<maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
		<maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
	</properties>

	<modules>
		<module>mugsun-bom</module>
		<module>mugsun-core-tool</module>
		<module>mugsun-starter-web</module>
		<module>mugsun-starter-mybatis</module>
	</modules>

	<!--
		Release / Maven Central:
		  mvn -Prelease clean deploy -DskipTests
		Credentials via ~/.m2/settings.xml server id "central"
		(or env CENTRAL_USERNAME / CENTRAL_PASSWORD wired by CI setup-java).
		GPG via local agent or env GPG_PASSPHRASE. Do not put secrets in the POM.
	-->
	<profiles>
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>${maven-source-plugin.version}</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>${maven-javadoc-plugin.version}</version>
						<configuration>
							<!-- JDK 21: avoid doclint hard-fails on sparse public API docs -->
							<doclint>none</doclint>
							<failOnError>true</failOnError>
							<failOnWarnings>false</failOnWarnings>
							<source>${java.version}</source>
							<detectJavaApiLink>false</detectJavaApiLink>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>${maven-gpg-plugin.version}</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<!-- CI / headless: use loopback pinentry; passphrase from env when set -->
							<gpgArguments>
								<arg>--pinentry-mode</arg>
								<arg>loopback</arg>
							</gpgArguments>
							<passphrase>${env.GPG_PASSPHRASE}</passphrase>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>${central-publishing.version}</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>true</autoPublish>
							<waitUntil>published</waitUntil>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
